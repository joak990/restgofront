# Base URL del backend.
# En DEV normalmente dejas vacío: Vite usa proxy /api -> localhost:3000/v1
# Para conectar a prod sin levantar nada local:
#   VITE_API_URL=https://restgoback.onrender.com/v1
# En PROD (Vercel) el vercel.json configura rewrite /api -> Render, así que acá va vacío.
VITE_API_URL=
